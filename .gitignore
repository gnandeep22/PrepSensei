# ==========================================
# PrepSensei — Production .gitignore
# Next.js 16 + TypeScript + Tailwind + pnpm
# ==========================================

# --- Dependencies & Package Managers ---
node_modules/
.pnpm-store/
.pnp/
.pnp.js

# --- Environment Variables & Credentials (CRITICAL) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert
*.p12

# Exception: Keep sanitized environment template tracked
!.env.example

# --- Production & Build Outputs ---
.next/
out/
build/
dist/
*.tsbuildinfo

# --- Turbopack & Cache Directories ---
.turbo/
.cache/
.eslintcache
.parcel-cache/

# --- Logs & Debug Dumps ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Code Coverage ---
coverage/
.nyc_output/
*.lcov
reports/
playwright-report/
test-results/

# --- Local Databases & SQLite Caches ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal

# --- Temporary & Upload Files ---
tmp/
temp/
uploads/
*.tmp
*.temp

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDEs & Code Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Sandbox / Vercel Artifacts ---
.vercel/
.now/
.snowflake/
.v0-trash/
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
