# Database (PostgreSQL - local database named prepsensei)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prepsensei"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your-better-auth-secret-32-chars-minimum"
BETTER_AUTH_URL="http://localhost:3000"

# AI Models (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Optional External APIs
INDIANAPI_KEY="your-indianapi-key"

# Gmail SMTP for OTP Email Verification (Optional)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"

# Jobful API (Optional)
JOBFUL_API_URL="http://localhost:5000"
